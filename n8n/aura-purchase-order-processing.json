      "name": "Purchase Order Received"
    },
    {
      "parameters": {
        "jsCode": "const order = $json.body ?? $json;\n\nconst errors = [];\n\n// Validate PO number\nif (!order.po_number || typeof order.po_number !== 'string') {\n  errors.push('PO number is missing');\n}\n\n// Validate supplier\nif (!order.supplier_name || typeof order.supplier_name !== 'string') {\n  errors.push('Supplier name is missing');\n}\n\n// Validate items\nif (!Array.isArray(order.items) || order.items.length === 0) {\n  errors.push('At least one item is required');\n} else {\n  order.items.forEach((item, index) => {\n\n    if (!item.product_id) {\n      errors.push(`Item ${index + 1}: product ID is missing`);\n    }\n\n    if (!item.product_sku) {\n      errors.push(`Item ${index + 1}: product SKU is missing`);\n    }\n\n    if (!item.product_name) {\n      errors.push(`Item ${index + 1}: product name is missing`);\n    }\n\n    if (!Number.isInteger(item.quantity) || item.quantity <= 0) {\n      errors.push(`Item ${index + 1}: quantity must be greater than 0`);\n    }\n\n    if (typeof item.unit_price !== 'number' || item.unit_price < 0) {\n      errors.push(`Item ${index + 1}: unit price is invalid`);\n    }\n  });\n}\n\n// Validate delivery date\nif (!order.delivery_date) {\n  errors.push('Delivery date is missing');\n} else if (isNaN(Date.parse(order.delivery_date))) {\n  errors.push('Delivery date is invalid');\n}\n\nreturn [\n  {\n    json: {\n      ...order,\n      validation: {\n        valid: errors.length === 0,\n        errors\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        112,
        -16
      ],
      "id": "dfe37be3-a0bf-4473-a65a-f83e131f0eeb",
