    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const reservation = $('Reserve Inventory').item.json;\n\nconst currentStatus = reservation.status;\n\nconst transitions = {\n  RESERVED: \"PRODUCTION_READY\",\n  PRODUCTION_READY: \"IN_PRODUCTION\",\n  IN_PRODUCTION: \"PRODUCTION_COMPLETE\",\n  PRODUCTION_COMPLETE: \"QC_PENDING\",\n  QC_PASSED: \"READY_FOR_DISPATCH\",\n  READY_FOR_DISPATCH: \"IN_TRANSIT\",\n  IN_TRANSIT: \"DELIVERED\",\n  DELIVERED: \"COMPLETED\"\n};\n\nconst nextStatus = transitions[currentStatus];\n\nif (!nextStatus) {\n  throw new Error(\n    `No automatic transition defined for status: ${currentStatus}`\n  );\n}\n\nreturn {\n  json: {\n    ...reservation,\n    previous_status: currentStatus,\n    status: nextStatus\n  }\n};"
      },
