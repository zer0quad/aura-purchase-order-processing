    {
      "parameters": {
        "sendTo": "{{ $env.SALES_EMAIL }}",
        "subject": "=Inventory Shortage - {{ $('Prepare Inventory Exception').item.json.order_number }}",
        "message": "=<h2>Inventory Shortage Alert</h2>\n\n<p>A shortage has been detected for the following purchase order.</p>\n\n<p>\n<strong>Purchase Order:</strong>\n{{ $('Prepare Inventory Exception').item.json.order_number }}\n</p>\n\n<p>\n<strong>Customer:</strong>\n{{ $('Prepare Inventory Exception').item.json.customer_name }}\n</p>\n\n<p>\n<strong>Product:</strong> {{ $json.product_name }}<br>\n<strong>SKU:</strong> {{ $json.product_sku }}<br>\n<strong>Requested Quantity:</strong> {{ $json.requested_quantity }}<br>\n<strong>Available Quantity:</strong> {{ $json.available_quantity }}<br>\n<strong>Shortage Quantity:</strong> {{ $json.shortage_quantity }}<br>\n<strong>Status:</strong> {{ $json.status }}\n</p>\n\n<p>Please initiate procurement for the shortage quantity.</p>\n\n<p>Regards,<br>\nAURA Procurement System</p>",
        "options": {}
      },
